<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="8dp" android:background="@drawable/wbg">
    <ImageView android:id="@+id/img" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:scaleType="fitCenter"/>
    <ListView android:id="@+id/list" android:layout_width="110dp" android:layout_height="match_parent"
        android:layout_marginStart="6dp" android:divider="@null" android:dividerHeight="0dp"/>
</LinearLayout>
